{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "centralized-inbox",
  "main": "worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "assets": {
    "run_worker_first": true,
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "centralized-inbox-db",
      // Replace with your own D1 database ID from: npx wrangler d1 create centralized-inbox-db
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // Optional: Email address where incoming customer emails should be forwarded
    "FORWARD_EMAIL": "your-email@example.com"
  }
}
