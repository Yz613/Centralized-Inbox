# Google Gemini API Key for AI smart replies and executive briefing (Optional)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Password Gate Configuration for Cloudflare Worker:
# Set these as secrets on Cloudflare using Wrangler:
#
# 1. Set your custom gate password:
#    npx wrangler secret put GATE_PASSWORD
#
# 2. Set your session encryption secret (any random 32+ character string):
#    npx wrangler secret put SESSION_SECRET
#
# 3. (Optional) Set Gemini API Key secret:
#    npx wrangler secret put GEMINI_API_KEY
