{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "deploy": "vite build && npx wrangler deploy",
    "d1:migrate": "npx wrangler d1 migrations apply centralized-inbox-db --remote",
    "d1:migrate:local": "npx wrangler d1 migrations apply centralized-inbox-db --local",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev:worker": "vite build && npx wrangler dev"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "hono": "^4.13.8",
    "imapflow": "^2.0.5",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.9.28",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.10",
    "postal-mime": "^3.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
